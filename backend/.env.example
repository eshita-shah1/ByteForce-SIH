# Copy this file to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL + PostGIS connection string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/manganese_gis

# Admin panel (HTTP Basic auth) and POST /api/auth/login (same credential).
# Leave ADMIN_PASSWORD empty to disable both entirely (fails closed, not
# open). ADMIN_USERNAME must be email-shaped - the frontend's login form is
# <input type="email">, which rejects a bare "admin" client-side.
ADMIN_USERNAME=admin@terrascope.local
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=change-me-in-production

# Upload handling
MAX_UPLOAD_SIZE_MB=200
UPLOAD_TTL_HOURS=24

# External live-data API (Open-Meteo needs no API key; this is here for
# parity with how a keyed provider would be configured, and so
# external_data_service.py has one place to read timeouts from).
EXTERNAL_API_TIMEOUT_SECONDS=10
